<Window x:Class="AppleMusicPlayer.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple Music Player"
        Width="264"
        Height="52"
        MinWidth="264"
        MaxWidth="360"
        MinHeight="52"
        MaxHeight="218"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Loaded="OnLoaded"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">
    <Window.Resources>
        <DropShadowEffect x:Key="IslandShadow" BlurRadius="22" ShadowDepth="3" Opacity="0.48" Color="#FF000000" />
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF202125" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Island" Background="{DynamicResource IslandBackground}" CornerRadius="26" Padding="12,8" Effect="{StaticResource IslandShadow}">
        <Grid>
            <Grid x:Name="CompactContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Border Width="25" Height="25" CornerRadius="6" Background="#FF292A2F">
                    <TextBlock Text="♫" Foreground="#FFE4E5E8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Apple Music" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="Ready to play" Foreground="{DynamicResource SecondaryText}" FontSize="9" />
                </StackPanel>
                <Canvas x:Name="CompactWaveform" Grid.Column="2" Height="28" VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="54" Height="54" CornerRadius="10" Background="#FF292A2F">
                            <TextBlock Text="♫" Foreground="#FFE4E5E8" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Apple Music" Foreground="{DynamicResource PrimaryText}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Your music, ready when you are" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="⌁" Foreground="{DynamicResource Accent}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Height="3" Margin="0,18,0,12" Background="#FF292A2F" CornerRadius="2">
                    <Border Width="35" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="2" />
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IslandButton}" Content="‹" />
                    <Button Style="{StaticResource IslandButton}" Content="▶" FontSize="14" Margin="10,0" />
                    <Button Style="{StaticResource IslandButton}" Content="›" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>