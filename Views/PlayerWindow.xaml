<Window x:Class="AppleMusicPlayer.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple Music Player"
        Width="264"
        Height="52"
        MinWidth="264"
        MaxWidth="520"
        MinHeight="52"
        MaxHeight="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Loaded="OnLoaded"
        Closed="OnClosed"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">
    <Window.Resources>
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF202125" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="16" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbDot" Width="10" Height="10" Fill="#FFF8F8FA" Opacity="0" />
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                        <Setter TargetName="ThumbDot" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="ShadowLayer" Background="#55000000" CornerRadius="26" Margin="0,3,0,0" />
        <Border x:Name="Island" Background="{DynamicResource IslandBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="26" Padding="12,8" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
          <Grid>
            <Grid x:Name="CompactContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CompactArtworkFrame" Width="25" Height="25" CornerRadius="6" Background="#FF292A2F" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="CompactArtworkFallback" Text="♫" Foreground="#FFE4E5E8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="CompactArtwork" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CompactTitle" Text="Nothing playing" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CompactArtist" Text="Open Apple Music to begin" Foreground="{DynamicResource SecondaryText}" FontSize="9" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Canvas x:Name="CompactWaveform" Grid.Column="2" Height="28" VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" MinWidth="0">
                        <Border x:Name="ExpandedArtworkFrame" Width="54" Height="54" CornerRadius="10" Background="#FF292A2F" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="ExpandedArtworkFallback" Text="♫" Foreground="#FFE4E5E8" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="ExpandedArtwork" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,1,12,0" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock x:Name="ExpandedTitle" Text="Nothing playing" Foreground="{DynamicResource PrimaryText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            <TextBlock x:Name="ExpandedArtist" Text="Open Apple Music to begin" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Style="{StaticResource IslandButton}" Content="⚙" FontSize="14" Click="OnSettingsClicked" ToolTip="Settings" />
                        <TextBlock Text="⌁" Foreground="{DynamicResource Accent}" FontSize="24" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
                <Slider x:Name="ProgressSlider" Grid.Row="1" Style="{StaticResource IslandSlider}" Margin="0,12,0,2" Minimum="0" Maximum="1" ValueChanged="OnProgressChanged" Thumb.DragStarted="OnSeekStarted" Thumb.DragCompleted="OnSeekCompleted" />
                <Grid x:Name="TimeLabels" Grid.Row="2" Margin="2,0,2,4">
                    <TextBlock x:Name="ElapsedTime" Text="0:00" FontSize="9" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TotalTime" Text="0:00" FontSize="9" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel x:Name="PlaybackControls" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ShuffleButton" Style="{StaticResource IslandButton}" Content="⤨" Click="OnShuffleClicked" />
                    <Button x:Name="PreviousButton" Style="{StaticResource IslandButton}" Content="‹" Click="OnPreviousClicked" />
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}" Content="▶" FontSize="14" Margin="10,0" Click="OnPlayPauseClicked" />
                    <Button x:Name="NextButton" Style="{StaticResource IslandButton}" Content="›" Click="OnNextClicked" />
                    <Button x:Name="RepeatButton" Style="{StaticResource IslandButton}" Content="↻" Click="OnRepeatClicked" />
                </StackPanel>
            </Grid>
          </Grid>
        </Border>
    </Grid>
</Window>